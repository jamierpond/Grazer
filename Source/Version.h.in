#pragma once

#include <string>

// Generated at build time from cmake/GitVersion.cmake — do not edit the copy in
// the build tree. The template lives at Source/Version.h.in.
namespace grazer
{
inline constexpr auto appVersion = "@GRAZER_PROJECT_VERSION@";
inline constexpr auto gitSha = "@GRAZER_GIT_SHA@";
inline constexpr bool gitDirty = @GRAZER_GIT_DIRTY@ != 0;

// Short label for crash reports, e.g. "e5c6236" or "e5c6236*" (dirty).
inline std::string versionTag()
{
    return std::string {gitSha} + (gitDirty ? "*" : "");
}
} // namespace grazer
